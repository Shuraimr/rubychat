<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice calls: the webview asks for the mic at runtime (wry's WebChromeClient shows the Android dialog) -->
    <!-- Sesli arama: webview mikrofonu çalışma anında ister (wry'nin WebChromeClient'ı Android penceresini gösterir) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Element Call: camera for video, a microphone foreground service so the call survives a locked screen / background (Android 14+), wake lock for the connection -->
    <!-- Element Call: görüntü için kamera, kilit ekranı / arka planda aramanın sürmesi için mikrofon ön plan servisi (Android 14+), bağlantı için wake lock -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notifications: the runtime permission (Android 13+) is asked when the user taps "Aç" on the permission card; full-screen intent = incoming call -->
    <!-- Bildirimler: çalışma anı izni (Android 13+) kullanıcı izin kartında "Aç"a dokununca istenir; tam ekran niyet = gelen arama -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Save to gallery: Android 10+ uses MediaStore (no permission); only Android 7-9 needs this one -->
    <!-- Galeriye kaydet: Android 10+ MediaStore kullanır (izin yok); yalnızca Android 7-9 buna ihtiyaç duyar -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- In-app self-update: lets the system package installer open a verified APK (Android 8+ asks per-app permission) -->
    <!-- Uygulama içi güncelleme: doğrulanmış APK'yı sistem paket yükleyicisinde açmayı sağlar (Android 8+ uygulama başına izin ister) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Which browsers / apps can open a web link (long press on a link) · Web bağlantısını hangi tarayıcı / uygulama açabilir (bağlantıya uzun bas) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="*" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.github.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.spotify.music" />
        <package android:name="org.telegram.messenger" />
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.rubychat"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- matrix.to links (no autoVerify: we do not own matrix.to; enabled via Settings on Android 12+) -->
            <!-- matrix.to bağlantıları (autoVerify yok: matrix.to bize ait değil; Android 12+'da Ayarlar'dan açılır) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="matrix.to" />
            </intent-filter>
            <!-- MSC2312 matrix: URIs · MSC2312 matrix: adresleri -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matrix" />
            </intent-filter>
        </activity>

        <!-- Notification actions (inline reply, mark as read) -->
        <!-- Bildirim eylemleri (satır içi yanıt, okundu işaretle) -->
        <receiver android:name=".BildirimEylemi" android:exported="false" />

        <!-- Call in progress: microphone foreground service + its "Kapat" action -->
        <!-- Süren arama: mikrofon ön plan servisi + "Kapat" eylemi -->
        <service android:name=".AramaServisi" android:exported="false" android:foregroundServiceType="microphone" />
        <!-- Background connection: keeps the sync alive (no push server) · Arka plan bağlantısı: eşitlemeyi canlı tutar (anlık bildirim sunucusu yok) -->
        <service android:name=".BaglantiServisi" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps the Matrix chat sync connected so messages can be notified without a push server" />
        </service>
        <receiver android:name=".AramaKapatAlici" android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
